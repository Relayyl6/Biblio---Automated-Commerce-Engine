{
  "expo": {
    "name": "Biblio Merchant",
    "slug": "ace-merchant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#090A0C",
    "ios": {
      "bundleIdentifier": "com.yemuel.biblio",
      "supportsTablet": true
    },
    "android": {
      "package": "com.yemuel.biblio",
      "adaptiveIcon": {
        "backgroundColor": "#090A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "backgroundColor": "#090A0C",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "acemerchant",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "23fb92b5-126c-440a-9905-50a78e359efd"
      }
    },
    "owner": "yemuel"
  }
}
