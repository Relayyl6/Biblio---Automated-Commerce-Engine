{
  "name": "ace-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "ACE — Autonomous Commerce Engine (Phase 1 WhatsApp MVP)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingestion": "tsx --env-file=.env ace-whatsapp/core/ingestion-service/src/index.ts",
    "payment": "tsx --env-file=.env ace-whatsapp/core/payment-verification/src/index.ts",
    "catalog-sync": "tsx --env-file=.env ace-whatsapp/core/catalog-sync/src/index.ts",
    "merchant-api": "tsx --env-file=.env ace-whatsapp/core/merchant-api/src/index.ts",
    "baileys-gateway": "tsx --env-file=.env ace-whatsapp/core/baileys-gateway/src/index.ts",
    "comms-router": "tsx --env-file=.env ace-whatsapp/core/comms-router/src/debounce.ts",
    "sms-webhook": "tsx --env-file=.env ace-whatsapp/core/comms-router/src/smsWebhook.ts",
    "logistics": "tsx --env-file=.env ace-whatsapp/core/logistics/src/index.ts",
    "pair": "tsx --env-file=.env pair.ts",
    "admin-portal": "npm --prefix ace-whatsapp/apps/admin-portal run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cors": "^8.5.0",
    "@hapi/boom": "^10.0.1",
    "@hubspot/api-client": "^14.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@whiskeysockets/baileys": "^6.7.18",
    "@xenova/transformers": "^2.17.2",
    "africastalking": "^0.7.9",
    "bullmq": "^5.34.0",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "googleapis": "^176.0.0",
    "groq-sdk": "^1.3.0",
    "ioredis": "^5.4.1",
    "jsforce": "^3.10.23",
    "jsonwebtoken": "^9.0.3",
    "mailchimp-api-v3": "^1.15.0",
    "ngrok": "^5.0.0-beta.2",
    "pino": "^9.0.0",
    "postgres": "^3.4.5",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^6.0.2",
    "xero-node": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/africastalking": "^0.8.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
