# ─────────────────────────────────────────────────────────────────────────────
# ACE WhatsApp — Phase 1 MVP environment
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
#
# `.env` is gitignored. Nothing here is read automatically — load it with your
# process manager, or `node --env-file=.env`, or `tsx --env-file=.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Datastores ───────────────────────────────────────────────────────────────
# Postgres (Neon recommended — use the POOLED connection string). Required:
# shared/src/clients.ts throws on startup if this is unset.
DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis. Used for the debounce queue (BullMQ), webhook idempotency, the
# negotiation arc, the per-customer turn lock, and the 24h service window.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ── Anthropic (the negotiation agent) ────────────────────────────────────────
# https://console.anthropic.com/ → API Keys. Model id is pinned in agentLoop.ts
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Groq (LLM + Whisper transcription) ───────────────────────────────────────
# https://console.groq.com/ → API Keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# From the Meta App dashboard → WhatsApp → API Setup.
#
# WHATSAPP_TOKEN          System-user / permanent access token used as the
#                         Bearer token on outbound Graph API sends.
# WHATSAPP_APP_SECRET     App secret — used to verify the X-Hub-Signature-256
#                         HMAC on every inbound webhook. Without it, the webhook
#                         is a public endpoint anyone can forge events against.
# WHATSAPP_VERIFY_TOKEN   An arbitrary string YOU choose; paste the same value
#                         into Meta's webhook "Verify token" field. Used only
#                         for the GET /webhook subscription handshake.
# WHATSAPP_GRAPH_VERSION  Graph API version. Defaults to v21.0 if unset.
WHATSAPP_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN_FALLBACK=your-fallback-token
GRAPH_API_VERSION=v25.0

# ── Payment provider (bank / PSP webhooks) ───────────────────────────────────
# PAYMENT_WEBHOOK_SECRET  Shared secret used to HMAC-verify inbound payment
#                         webhooks. For Paystack this is your secret key; for a
#                         bank-partner adapter it's whatever signing key you
#                         configure. The handler checks x-ace-signature,
#                         x-paystack-signature, or verif-hash headers.
# PAYMENT_PORT            Port the payment-verification webhook listens on.
PAYMENT_WEBHOOK_SECRET=sk_test_your-paystack-secret-key
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYMENT_PORT=3002

# ── Catalog sync (Meta Commerce Catalog → products) ──────────────────────────
# Reuses WHATSAPP_TOKEN for Graph auth. The catalog id is per-merchant
# (merchants.whatsapp_catalog_id), set via the merchant-api or seed.
# CATALOG_PRICE_MINOR_UNITS  "true" (default) treats Meta prices as kobo (÷100);
#                            set "false" if your catalog stores whole naira.
# CATALOG_DEFAULT_STOCK      Stock assumed for "in stock" items with no count.
# CATALOG_SYNC_PORT          Port for the standalone catalog-sync service.
CATALOG_PRICE_MINOR_UNITS=true
CATALOG_DEFAULT_STOCK=100
CATALOG_SYNC_PORT=3003

# ── Merchant / Admin API (self-serve onboarding) ─────────────────────────────
# ADMIN_API_KEY      If set, every merchant-api route requires a matching
#                    `x-api-key` header. Leave unset for open local dev.
# MERCHANT_API_PORT  Port the merchant-api listens on.
ADMIN_API_KEY=
MERCHANT_API_PORT=3004

# ── Cloudinary (vendor product image CDN) ────────────────────────────────────
# Required for the baileys-gateway vendor inventory pipeline.
# When a vendor sends a product photo via WhatsApp, the image is uploaded here
# and the returned CDN URL is stored in products.image_url — enabling Status
# broadcasts and dashboard thumbnails.
# Create a free account at https://cloudinary.com/ → Settings → Access Keys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Africa's Talking (SMS escalations) ───────────────────────────────────────
# https://account.africastalking.com/ → Settings → API Key
AT_API_KEY=your-at-api-key
AT_USERNAME=sandbox

# ── Logistics couriers ────────────────────────────────────────────────────────
KWIK_API_KEY=your_kwik_key
SENDBOX_API_KEY=your_sendbox_key

# ── Tunables ─────────────────────────────────────────────────────────────────
# DEBOUNCE_MS  How long to wait for a customer to stop typing before firing one
#              consolidated turn. 8–12s is a good MVP feel.
# PORT         Port the ingestion-service HTTP webhook listens on.
DEBOUNCE_MS=10000
PORT=3001
